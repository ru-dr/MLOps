# Stage 1: install dependencies on a slim Python base
FROM python:3.12-slim AS base

# Don't write .pyc files and flush stdout immediately so logs show up in `docker logs`
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# Copy requirements first so the pip layer is cached until dependencies change
COPY src/requirements.txt .
RUN pip install -r requirements.txt

# Stage 2: run the test suite (docker build --target test .)
FROM base AS test
COPY src/ src/
COPY requirements-dev.txt .
RUN pip install -r requirements-dev.txt
COPY tests/ tests/
RUN python -m pytest -q -p no:cacheprovider tests

# Stage 3: training image
FROM base AS train

# Run as a non-root user
RUN useradd --create-home appuser && mkdir -p /app/output && chown appuser /app/output
COPY src/main.py .
USER appuser

# Model and metrics are written here; mount a volume to keep them on the host
VOLUME ["/app/output"]

# Run the script when the container launches
CMD ["python", "main.py"]
